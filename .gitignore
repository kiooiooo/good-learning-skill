# Keep the public repository limited to the skill and its supporting code
/*
!/SKILL.md
!/README.md
!/LICENSE
!/requirements.txt
!/.gitignore
!/examples/
!/references/
!/scripts/
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/good-learning/
/.agents/skills/good-learning/*
!/.agents/skills/good-learning/SKILL.md
!/.agents/skills/good-learning/scripts
!/.agents/skills/good-learning/references
!/.agents/skills/good-learning/requirements.txt
/examples/*
!/examples/*.json
/references/*
!/references/*.md
/scripts/*
!/scripts/*.py

# Local generated files and caches
**/__pycache__/
*.py[cod]
.DS_Store
